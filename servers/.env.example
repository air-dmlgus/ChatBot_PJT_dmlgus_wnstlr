# 이 파일을 복사해서 같은 폴더(servers)에 ".env" 라는 이름으로 저장한 뒤 값을 채우세요.
#   Windows : copy .env.example .env
#   Mac     : cp .env.example .env
# .env 는 .gitignore 에 포함되어 있어 GitLab에 올라가지 않습니다. (키 유출 주의!)

# GMS에서 발급받은 키 (https://gms.ssafy.io)
GMS_KEY=여기에_GMS_KEY를_붙여넣으세요

# GMS를 통한 OpenAI 엔드포인트 (기존 https://api.openai.com/v1 앞에 GMS 주소를 붙인 형태)
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1

# 사용할 모델 (가벼운 모델 권장). GMS에서 지원하는 모델명으로 바꿔 쓸 수 있습니다.
#   예) gpt-4.1-nano, gpt-4.1-mini, gpt-5.4-nano
GPT_MODEL=gpt-5.4-mini

# 임베딩(문장 → 벡터) 모델. GMS '임베딩' 탭에 있는 모델명을 씁니다.
#   예) text-embedding-3-large (한국어 검색 정확도 높음, 기본값), text-embedding-3-small (저렴)
EMBEDDING_MODEL=text-embedding-3-large
